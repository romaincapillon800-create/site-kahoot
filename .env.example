# ===== ENVIRONNEMENT =====
NODE_ENV="development"

# ===== DATABASE =====
DATABASE_URL="postgresql://user:password@localhost:5432/cyberlearn?schema=public"

# ===== AUTHENTIFICATION =====
# IMPORTANT: Générer des valeurs sécurisées en production!
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="votre-secret-jwt-32-caracteres-aleatoires-minimum"

# Admin credentials (REQUIRED - no defaults for security)
# Must be configured as environment variables before deployment
ADMIN_EMAIL="votre-email-admin@example.com"
ADMIN_PASSWORD="votre-mot-de-passe-securise-ici"

# ===== SERVEUR =====
PORT="3000"
HOSTNAME="localhost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
SOCKET_RATE_LIMIT_WINDOW_MS="1000"
SOCKET_RATE_LIMIT_MAX_EVENTS="10"
