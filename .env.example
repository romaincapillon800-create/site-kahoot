# ===== ENVIRONNEMENT =====
NODE_ENV="development"

# ===== DATABASE =====
DATABASE_URL="postgresql://user:password@localhost:5432/cyberlearn?schema=public"

# ===== AUTHENTIFICATION =====
# IMPORTANT: Générer des valeurs sécurisées en production!
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="votre-secret-jwt-32-caracteres-aleatoires-minimum"
ADMIN_EMAIL="admin@cyberlearn.local"

# ATTENTION: Remplacer par un hash bcryptjs en production
# Générer le hash: npx bcryptjs hash "votre-mot-de-passe-secure"
ADMIN_PASSWORD_HASH="$2a$12$..."

# ===== SERVEUR =====
PORT="3000"
HOSTNAME="localhost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== SÉCURITÉ =====
ENABLE_HTTPS="false"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
SOCKET_RATE_LIMIT_WINDOW_MS="1000"
SOCKET_RATE_LIMIT_MAX_EVENTS="10"
